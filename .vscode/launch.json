{
    "version": "0.2.0",
    "configurations": [
        {
            "type": "node",
            "request": "launch",
            "name": "Debug node:test",
            "runtimeArgs": [
                "--test",
                "--enable-source-maps"
            ],
            "args": [
                "${workspaceFolder}/test/**/*.test.js"
            ],
            "cwd": "${workspaceFolder}",
            "preLaunchTask": "ts-build",
            "console": "integratedTerminal",
            "internalConsoleOptions": "neverOpen",
            "sourceMaps": true
        }
    ]
}
